{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Behavioral Harness Trace",
  "type": "object",
  "required": ["schema_version", "observability", "skill_events", "workflow_events", "status"],
  "properties": {
    "schema_version": {"const": 1}, "observability": {"type": "object"},
    "skill_events": {"type": "array", "items": {"type": "object", "required": ["event_id", "skill_id", "event", "evidence_source", "timestamp"], "properties": {
      "event_id": {"type": "string"}, "skill_id": {"type": "string"}, "event": {"enum": ["read", "selected", "applied", "unknown"]}, "evidence_source": {"enum": ["tool-observation", "orchestrator", "runner-self-report", "replay", "unknown"]}, "artifact_ref": {"type": ["string", "null"]}, "timestamp": {"type": "string"}
    }, "additionalProperties": true}},
    "workflow_events": {"type": "array", "items": {"type": "object", "required": ["event_id", "workflow", "event", "evidence_source", "timestamp"], "properties": {
      "event_id": {"type": "string"}, "workflow": {"type": "string"}, "event": {"enum": ["read", "selected", "applied", "unknown"]}, "evidence_source": {"enum": ["tool-observation", "orchestrator", "runner-self-report", "replay", "unknown"]}, "artifact_ref": {"type": ["string", "null"]}, "timestamp": {"type": "string"}
    }, "additionalProperties": true}},
    "status": {"type": "object", "required": ["observed_status", "source"], "properties": {"observed_status": {"enum": ["pass", "partial", "blocked", "fail", "unverifiable"]}, "source": {"type": "string"}}, "additionalProperties": true}
  }, "additionalProperties": false
}
