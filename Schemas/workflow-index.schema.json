{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "workflows"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "workflows": {
      "type": "array",
      "items": {"type": "string", "pattern": "^Workflows/.+\\.md$"},
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
