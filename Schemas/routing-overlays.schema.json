{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://borstwerk.github.io/KI-Regeln/schemas/routing-overlays.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "overlays"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "overlays": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "skill",
          "phase",
          "checkpoints"
        ],
        "properties": {
          "skill": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "phase": {
            "enum": [
              "presentation",
              "communication",
              "assurance",
              "security"
            ]
          },
          "checkpoints": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "post-primary",
                "pre-execution",
                "pre-completion",
                "pre-output"
              ]
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
